# Remote Magpie web service: enables configured route groups and full usage totals.
# Set the origin including scheme and port, without /?k= or any other path/query.
# The key is MAGPIE_WEB_KEY on the service, or the key in its sign-in link.
# Do not use a model gateway API key here. Keep this file private.
MAGPIE_WEB_URL=
MAGPIE_WEB_KEY=

# Only needed behind a reverse proxy: the Magpie WEB process's internal listen port.
# Example: external https://magpie.example -> internal magpie web on :3430.
# MAGPIE_WEB_COOKIE_PORT=3430

# Alternative: local gateway access, without configured-group details.
# MAGPIE_WEB_URL takes precedence when both are set.
MAGPIE_URL=http://127.0.0.1:3425

# Optional gateway API key. Usually not required for local read-only endpoints.
# This is NOT MAGPIE_WEB_KEY. Never put this in public/ or a URL.
MAGPIE_API_KEY=

# Optional local recorded routing history, useful on older Magpie releases.
# Default for a loopback gateway: $XDG_CONFIG_HOME/magpie/routing or ~/.config/magpie/routing.
# Remote web and remote gateway connections never merge this machine's history.
# Set off to disable reading disk history.
# MAGPIE_HISTORY_DIR=/home/you/.config/magpie/routing

PORT=4317
