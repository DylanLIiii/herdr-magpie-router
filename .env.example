# Recommended: open Routing > Connection in Herdr and enter the Magpie URL/key.
# Saved connection settings take precedence over these optional environment defaults.
# Actual credentials belong in .env or the private saved settings, never this example.
# Remote Magpie Web service: HTTP(S) base URL, optionally /mac/ or another proxy path.
# Do not include a sign-in query such as /?k=, fragments or embedded credentials.
# The Web key corresponds to the service's MAGPIE_WEB_RUNKEY / sign-in link.
# It is distinct from the model gateway API key.
MAGPIE_WEB_URL=
MAGPIE_WEB_KEY=

# Only needed behind a reverse proxy: the Magpie WEB process's internal listen port.
# Example: external https://magpie.example -> internal magpie web on :3430.
# MAGPIE_WEB_COOKIE_PORT=3430

# Alternative: local gateway access, without configured-group details.
# MAGPIE_WEB_URL takes precedence when both are set.
MAGPIE_URL=http://127.0.0.1:3425

# Optional gateway API key. Usually not required for local read-only endpoints.
# This is NOT MAGPIE_WEB_KEY. Never put this in public/ or a URL.
MAGPIE_API_KEY=

# Optional local recorded routing history, useful on older Magpie releases.
# Default for a loopback gateway: $XDG_CONFIG_HOME/magpie/routing or ~/.config/magpie/routing.
# Remote web and remote gateway connections never merge this machine's history.
# Set off to disable reading disk history.
# MAGPIE_HISTORY_DIR=/home/you/.config/magpie/routing

# Optional private settings location. Default:
# $XDG_CONFIG_HOME/herdr-magpie-router/connection.json, or
# ~/.config/herdr-magpie-router/connection.json (written atomically with mode 0600).
# MAGPIE_CONNECTION_FILE=/private/path/connection.json

PORT=4317
