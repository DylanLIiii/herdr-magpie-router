{
  "name": "herdr-magpie-router",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only Magpie routing observatory and composable Herdr mod",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "check": "node scripts/check.js",
    "install:layout": "node scripts/install-layout.js",
    "install:panel": "node scripts/install-panel.js",
    "attach:panel": "node scripts/attach-panel.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
